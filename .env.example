# Supabase project (Dashboard -> Project Settings -> API)
# Admin sign-in uses Supabase Auth of this same project (publishable key);
# create the first admin with: npm run admin:create -- you@example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# SERVER ONLY. Bypasses Row Level Security - never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never commit the real value.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Cloudinary unsigned upload preset (product images).
# If the upload to Cloudinary fails, images fall back to Supabase Storage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Storefront cache refresh after each admin change (optional but recommended).
# Must match REVALIDATE_SECRET in grocery-store. Generate with: openssl rand -hex 32
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=replace_with_a_long_random_string
